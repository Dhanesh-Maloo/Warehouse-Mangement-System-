# ─── Database ────────────────────────────────────────────────────────────────
# Postgres 15 — matches infra/docker-compose.yml defaults
DATABASE_URL=postgresql://warehouse:warehouse@localhost:5432/warehouse

# ─── Object Storage ──────────────────────────────────────────────────────────
# Local dev: LocalStack (run via docker compose)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=warehouse

# Production (Cloudflare R2): replace all four values below
# AWS_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET=warehouse

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must be a long random string in production — never commit the real value.
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRY=12h

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# ─── Seed ────────────────────────────────────────────────────────────────────
# Required only when running `pnpm db:seed`. Never commit a real password here.
SEED_ADMIN_PASSWORD=
